# Growth Masala — Environment Variables
# Copy this file to .env.local and fill in the values
# NEVER commit .env.local to git

# Anthropic Claude API (for chatbot)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Contact form email (Gmail + Nodemailer)
# Generate an App Password: Google Account → Security → 2-Step Verification → App passwords
GMAIL_USER=growthmasala@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password
CONTACT_EMAIL=growthmasala@gmail.com

# WhatsApp number (with country code, no + sign)
NEXT_PUBLIC_WHATSAPP_NUMBER=91XXXXXXXXXX

# Site URL (for SEO and sitemap)
NEXT_PUBLIC_SITE_URL=https://growthmasala.com

# Google Analytics 4 Measurement ID (format: G-XXXXXXXXXX)
# Must also be set in the Vercel dashboard — .env.local is local-only,
# so production collects no data unless it is set there too.
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Google Search Console — HTML tag verification (optional)
# Only needed if you verify via the "HTML tag" method instead of DNS TXT.
# Search Console shows: <meta name="google-site-verification" content="TOKEN" />
# Put just the TOKEN here (not the whole tag), set it in Vercel, then REDEPLOY —
# pages are statically prerendered, so this is read at build time. Setting the
# variable without a new deploy will not make the tag appear.
# Leave unset if you verified via DNS TXT (recommended).
GOOGLE_SITE_VERIFICATION=
